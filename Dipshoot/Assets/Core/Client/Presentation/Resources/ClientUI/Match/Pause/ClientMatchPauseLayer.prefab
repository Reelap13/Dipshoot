  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
    \u0442\u043E\u0447\u043A\u0443 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
    \u0435\u0451 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u043B\u044C\u0448\u0435.
    \u0414\u043B\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0441\u0442\u043E\u0439\u0442\u0435
    \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u0440\u0443\u0433\u0430, \u043F\u043E\u043A\u0430
    \u0448\u043A\u0430\u043B\u0430 \u043D\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F
    \u0446\u0432\u0435\u0442\u043E\u043C \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u044B.
    \u041D\u0435 \u0434\u0430\u0439\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443
    \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E.\r\n"
